\outl0\strokewidth0 \strokec2 cat << 'EOF' > ~/Desktop/sonar_app.py import os from PIL import Image import streamlit as st from ultralytics import YOLO st.set_page_config(page_title="Sonar Shipwreck Segmentation System", layout="wide", initial_sidebar_state="expanded") st.markdown(""" <style> .main-header \{ font-size: 2.0rem; font-weight: 700; color: #1E3A8A; margin-bottom: 0px; letter-spacing: -0.5px; \} .sub-header \{ font-size: 1.0rem; color: #4B5563; margin-bottom: 25px; font-weight: 400; \} .stButton>button \{ width: 100%; background-color: #1E3A8A; color: white; font-weight: 600; border-radius: 4px; border: none; \} .stButton>button:hover \{ background-color: #1E40AF; color: white; \} </style> """, unsafe_allow_html=True) @st.cache_resource def load_segmentation_model(): model_path = "/Users/krishmahto236gmail.com/runs/segment/shipwreck_segmentation/segmentation_run/weights/best.pt" if os.path.exists(model_path): return YOLO(model_path) return None model = load_segmentation_model() with st.sidebar: st.markdown("### Configuration") st.markdown("---") conf_threshold = st.slider("Confidence Threshold", 0.05, 0.95, 0.25, 0.05) iou_threshold = st.slider("IoU Threshold (NMS)", 0.1, 0.9, 0.45, 0.05) st.markdown("---") st.markdown("### System Status") if model is not None: st.success("Model Status: Online") else: st.error("Model Status: Weights Not Found") st.markdown('<p class="main-header">Sonar Imagery Shipwreck Detection</p>', unsafe_allow_html=True) st.markdown('<p class="sub-header">Automated Side-Scan Sonar Instance Segmentation & Acoustic Shadow Analysis System</p>', unsafe_allow_html=True) st.markdown("---") col_input, col_output = st.columns([1, 1], gap="large") with col_input: st.markdown("#### Input Parameters") # Updated file uploader to accept multiple files uploaded_files = st.file_uploader("Select Side-Scan Sonar Scans", type=["jpg", "jpeg", "png"], accept_multiple_files=True) if uploaded_files: st.write(f"Selected \{len(uploaded_files)\} image(s) for analysis.") for uploaded_file in uploaded_files: input_image = Image.open(uploaded_file) st.image(input_image, caption=f"Source: \{uploaded_file.name\}", use_container_width=True) with col_output: st.markdown("#### Segmentation Output") if uploaded_files and model is not None: if st.button("Execute Batch Analysis"): with st.spinner("Processing acoustic layers and generating masks across images..."): for uploaded_file in uploaded_files: input_image = Image.open(uploaded_file) results = model.predict(source=input_image, conf=conf_threshold, iou=iou_threshold) res = results[0] res_plotted = res.plot()[..., ::-1] st.markdown(f"**Results for: \{uploaded_file.name\}**") st.image(res_plotted, caption=f"Detected Overlays - \{uploaded_file.name\}", use_container_width=True) boxes = res.boxes num_detections = len(boxes) if boxes is not None else 0 m1, m2 = st.columns(2) with m1: st.metric(label="Targets Identified", value=num_detections) with m2: if num_detections > 0 and boxes.conf is not None: max_conf = float(boxes.conf.max()) st.metric(label="Maximum Confidence", value=f"\{max_conf:.2%\}") else: st.metric(label="Maximum Confidence", value="0.00%") st.markdown("---") else: st.info("Please upload one or more target sonar images using the left panel to begin batch analysis.") EOF streamlit run ~/Desktop/sonar_app.py}